    "exponent":  {"hex": "#FFD54F", "use": "exponents, root indexes, hops/counts, key verbs in captions"},
    "result":    {"hex": "#83C167", "use": "answers, correct results, check marks"},
    "warning":   {"hex": "#FC6255", "use": "traps, wrong answers, crosses, 'not'"},
    "ink":       {"hex": "#ECEFF4", "use": "default text and math, plain coefficients"},
    "muted":     {"hex": "#7D869C", "use": "secondary labels, header topic, example lines"},
    "card_fill": "#141824",
    "card_stroke": "#2A3042"
  },
  "fonts": {
    "text": "Avenir Next (captions, labels, header; MEDIUM for captions, BOLD for labels/header)",
    "math": "LaTeX Computer Modern via Manim MathTex (the 3Blue1Brown look)",
    "post_examples": "LaTeX \\text{} (serif) in muted color"
  },
  "math_font_sizes": {"HERO": 210, "BIG": 150, "MID": 110, "SMALL": 84, "caption": 40, "label": 38},
  "safe_zone_units": {
    "note": "Frame x ∈ [-4.5, 4.5], y ∈ [-8, 8]. Avoid top 15%, bottom 25%, right 12% (platform UI).",
    "top": 5.6, "bottom": -4.0, "left": -3.9, "right": 3.42, "center_x": -0.24,
    "header_y": 5.15, "math_zone_center_y": 1.75, "math_zone_max_height": 4.5, "caption_center_y": -2.45
  },
  "header": "TOPIC (muted, letter-spaced, bold) + 'n / N' (ink) + three short bars in base/exponent/result",
